{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "booksnap-ui",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-c",
        "import os, uvicorn; uvicorn.run('booksnap.server:app', host='0.0.0.0', port=int(os.environ.get('PORT', '8756')))"
      ],
      "port": 8756,
      "autoPort": false,
      "env": {
        "BOOKSNAP_CATALOG_BACKEND": "simania",
        "BOOKSNAP_FALLBACK": "google_vision"
      }
    },
    {
      "name": "product-api",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-c",
        "import os, uvicorn; uvicorn.run('app.main:app', host='127.0.0.1', port=int(os.environ.get('PORT', '8757')), reload=False)"
      ],
      "port": 8757,
      "autoPort": false
    },
    {
      "name": "product-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "app/web", "run", "dev"],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "ui-mock",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8790", "--directory", "planning/mockup"],
      "port": 8790
    }
  ]
}
