# --- secrets: NEVER commit these ---
.env
.env.*
!.env.example
*.key
*-key.json
service-account*.json
credentials.json
gcloud-*.json

# --- generated at runtime ---
# (crops, debug overlays, OCR cache, catalog response caches, run history)
# NOTE: gitignore has no inline comments — a trailing comment on the pattern
# line makes the pattern match nothing.
work/
*.log
results.json

# --- downloaded model blobs (fetched by setup.sh; ~5MB, not source) ---
tessdata/
tessfast/

# --- product client (app/web): installed deps and build output ---
# package-lock.json IS committed: reproducible installs are the point.
node_modules/
app/web/dist/
app/web/.vite/
app/web/vite.config.ts.timestamp-*
app/admin/dist/
app/admin/.vite/
app/admin/vite.config.ts.timestamp-*
app/ui/.vite/
# the P6.0 map lab — build output only; its source and lockfile are committed
planning/map-lab/dist/
planning/map-lab/.vite/
app/ui/vite.config.ts.timestamp-*

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
env/

# --- session scratch / handoff notes (not source, not durable memory) ---
# durable project memory lives in CLAUDE.md; this is per-session narrative
notes/

# --- editor / OS ---
.vscode/
.idea/
.DS_Store

# --- per-user Claude Code permissions (machine-local) ---
.claude/settings.local.json

# --- downloaded model checkpoints (fetched, not source) ---
models/
*.pt
*.pth

# Per-test timings, written by tests/run_all.py to balance its shards.
# A cache: a missing or stale file costs a little balance, never correctness.
tests/.durations.json
