# TLS and the one public door (P4.4).
#
# Caddy gets a certificate automatically, which is the whole reason it is
# here rather than nginx: the deployment step that most often goes stale is
# certificate renewal, and this one has no step.

{$BOOKSNAP_DOMAIN} {
	encode gzip

	# ⚠ The staff console's service is NOT routed here. It is cross-tenant
	# and read-only-by-construction, and the operator reaches it over an SSH
	# tunnel (see DEPLOY.md) — a shared token on the public internet is a
	# password with no rate limit and no rotation story.

	# A body ceiling in front of everything: the pre-auth sign-in routes
	# buffer a request before validating it, so an unbounded body is memory
	# an unauthenticated caller can spend (P4.1b's security review). 45 MB
	# clears the 40 MB upload limit `disk_blobs.py` enforces itself.
	request_body {
		max_size 45MB
	}

	header {
		# A year of HTTPS-only, so a downgrade cannot lift the session
		# cookie off the wire before the redirect happens.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		# The members drawer has remove/rename controls a hostile frame
		# would be happy to borrow a click for.
		Content-Security-Policy "frame-ancestors 'none'"
		Referrer-Policy "same-origin"
		-Server
		-Via
	}

	# The visitor's address behind the Cloudflare Worker (DEPLOY.md "Under
	# a path prefix"): the Worker stamps X-Booksnap-Visitor, and the api
	# keys its sign-in rate door on it (BOOKSNAP_VISITOR_HEADER). Believed
	# from Cloudflare's published ranges ONLY — https://www.cloudflare.com/ips
	# — and DELETED from anything else, or the door is whatever the caller
	# types (the Dockerfile's ⚠ on --forwarded-allow-ips, one hop out).
	@via_cloudflare {
		remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
	reverse_proxy @via_cloudflare api:8757 {
		header_up X-Forwarded-Proto {scheme}
	}
	reverse_proxy api:8757 {
		header_up X-Forwarded-Proto {scheme}
		header_up -X-Booksnap-Visitor
	}
}
