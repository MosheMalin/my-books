{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vitest/globals", "@testing-library/jest-dom"],

    /* Strict: the whole point of D3's TypeScript decision is that a DTO
       change becomes a build failure, and that only holds under strict. */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,

    /* The shared library, consumed as source. It is compiled by THIS
       tsconfig, which is why app/ui carries the identical strictness — a
       shared component that only typechecks under looser settings would fail
       here, in the app, where it is hardest to read. */
    "paths": {
      "@booksnap/ui": ["../ui/src/index.ts"],
      "@booksnap/ui/*": ["../ui/src/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
