{
  "name": "booksnap-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "booksnap product client. Talks only to /api/v1 (H1). Not the tuning UI — that stays booksnap/static/index.html.",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "postinstall": "npm --prefix ../ui install --no-audit --no-fund --silent",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "prebuild": "node ../ui/check-installed.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "node ../ui/check-installed.mjs",
    "gen:api": "openapi-typescript ../api/openapi.json -o ../ui/src/api/schema.d.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.0"
  }
}
