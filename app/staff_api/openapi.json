    "/api/staff/v1/libraries/{library_id}/shelves": {
      "get": {
        "description": "⚠ Cross-tenant, so it cannot be `/api/v1/shelves`: that resolves the\ncaller's membership, and a system administrator is a member of\nnothing. Note the consequence for the console — an EMPTY list and a\nlibrary that does not exist look the same here, deliberately: this\nservice has no reason to distinguish them, and the library list it\ncame from is the authority on which ids are real.",
        "operationId": "shelves_api_staff_v1_libraries__library_id__shelves_get",
        "parameters": [
          {
            "in": "path",
            "name": "library_id",
            "required": true,
            "schema": {
              "title": "Library Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-booksnap-staff",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Booksnap-Staff"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ShelfDTO"
                  },
                  "title": "Response Shelves Api Staff V1 Libraries  Library Id  Shelves Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "One library's shelves"
      }
    },
