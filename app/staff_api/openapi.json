  "info": {
    "description": "System administration, across every tenant. Read-only.",
    "title": "booksnap staff API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/staff/v1/accounts": {
      "get": {
        "description": "⚠ This is the route that has no equivalent in `/api/v1`, and could\nnot have one: the product API answers *\"which libraries may I name\"*,\nnever *\"who is in the system\"*.\n\nIt reports identity and membership — who exists, and what they may\nreach. It deliberately does not report what any individual has been\nREADING or photographing: \"statistics about the users\" is a fair thing\nfor an operator to want, and a per-person activity feed of someone's\nown household is a different and much larger power. Aggregate figures\nlive on the library rows instead.",
        "operationId": "accounts_api_staff_v1_accounts_get",
        "parameters": [
          {
            "in": "header",
            "name": "x-booksnap-staff",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Booksnap-Staff"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AccountDTO"
                  },
                  "title": "Response Accounts Api Staff V1 Accounts Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Every account, with its memberships"
      }
    },
    "/api/staff/v1/books": {
      "get": {
        "operationId": "books_api_staff_v1_books_get",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "default": "",
              "title": "Q",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "library_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Library Id"
            }
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "default": "title",
              "title": "Sort",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "ascending",
            "required": false,
            "schema": {
              "default": true,
              "title": "Ascending",
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "x-booksnap-staff",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Booksnap-Staff"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookPageDTO"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Books across every tenant"
      }
    },
    "/api/staff/v1/libraries": {
      "get": {
        "operationId": "libraries_api_staff_v1_libraries_get",
        "parameters": [
          {
            "in": "header",
