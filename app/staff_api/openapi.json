      "ImageDTO": {
        "description": "One photograph — the console's unit since revision 4.\n\n⚠ **This replaced `ShelfDTO`, and the replacement is the point.** VISION\n§4.1a records that \"one image = one shelf\" is a PLACEHOLDER with a recorded\nexit (P2.1): intake mints a shelf identity per photograph until pillar 6's\nmap can say two photographs are the same piece of wood. A console listing\nshelves was therefore listing photographs under a noun they had not earned.\nSo the image leads, and `shelf_id`/`depth`/`order` are reported as the SLOT\nit is currently filed at — the pair pillar 6 replaces with a real address.\n\n⚠ **No bytes are served by this service, only facts about them.** An\noperator looking at a household's actual photographs is a larger power than\ncounting them; the console renders a thumbnail only for a library the\noperator is a member of, through the product API, exactly as the household\nclient does.",
        "properties": {
          "auto": {
            "title": "Auto",
            "type": "integer"
          },
          "bytes": {
            "title": "Bytes",
            "type": "integer"
          },
          "captured_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Captured At"
          },
          "content_type": {
            "title": "Content Type",
            "type": "string"
          },
          "depth": {
            "title": "Depth",
            "type": "integer"
          },
          "filename": {
            "title": "Filename",
            "type": "string"
          },
          "findings": {
            "title": "Findings",
            "type": "integer"
          },
          "height": {
            "title": "Height",
            "type": "integer"
          },
          "id": {
            "description": "The capture id. There is no separate image entity yet — a capture IS a photograph filed somewhere, and `image_key` is its content address.",
            "title": "Id",
            "type": "string"
          },
          "image_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Key"
          },
          "last_read": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Read"
          },
          "library_id": {
            "title": "Library Id",
            "type": "string"
          },
          "order": {
            "title": "Order",
            "type": "integer"
          },
          "present": {
            "description": "The bytes are on disk. False is a real finding — a photograph the household can no longer see — not a blank cell. ⚠ Only when `blobs_visible`; otherwise it means nobody looked.",
            "title": "Present",
            "type": "boolean"
          },
          "reads": {
            "description": "Runs that CONSUMED this photograph (`reads.capture_ids`), which is not the same as runs that found something in it — a run that found nothing is exactly what an operator is looking for.",
            "title": "Reads",
            "type": "integer"
          },
          "review": {
            "title": "Review",
            "type": "integer"
          },
          "shelf_id": {
            "title": "Shelf Id",
            "type": "string"
          },
          "shelf_label": {
            "title": "Shelf Label",
            "type": "string"
          },
          "unmatched": {
            "title": "Unmatched",
            "type": "integer"
          },
          "width": {
            "title": "Width",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "library_id",
          "shelf_id",
          "shelf_label",
          "depth",
          "order",
          "present",
          "bytes",
          "width",
          "height",
          "content_type",
          "filename",
          "reads",
          "findings",
          "auto",
          "review",
          "unmatched"
        ],
        "title": "ImageDTO",
        "type": "object"
      },
      "ImagePageDTO": {
        "properties": {
          "blobs_visible": {
            "description": "⚠ Read this BEFORE `present`. When false, the service cannot see the blob tree at all (the database and the photographs may live on different machines), so every row reports `present: false` and zero bytes — which is 'we did not look', not 'they are gone'. A console that conflated the two would announce that every photograph in every tenant was lost, and hide a real loss among the noise.",
            "title": "Blobs Visible",
            "type": "boolean"
