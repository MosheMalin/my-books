# booksnap configuration — copy to .env (gitignored) and fill in.
# Everything here is read by the composition roots' tiny dotenv loaders
# (app/main.py, app/staff_api/main.py, booksnap/server.py); real env vars win.

# --- engine credentials (never commit real values) ---
# ANTHROPIC_API_KEY=            # llmpage/fullpage reading modes
# NLI_API_KEY=                  # NLI catalogue retrieval (no guest key)
# GOOGLE_APPLICATION_CREDENTIALS=   # path to a service-account JSON (Vision)

# --- product ---
# BOOKSNAP_DB=work/product.db       # the product database
# BOOKSNAP_BLOBS=work/product_blobs # uploaded photos
# BOOKSNAP_RUN_RATE_CAP=30          # reads/hr per ACCOUNT (retry-loop guard)

# The address the emailed sign-in link lands on. Unset, the dev mailer
# guesses the machine's LAN address (the phone must be able to open it —
# localhost on the phone is the phone).
# BOOKSNAP_PUBLIC_URL=http://192.168.1.20:5173

# Links the magic-link identity to a pre-P4.1 user row missing an email.
# Obsolete once every user row has one; harmless to leave set.
# BOOKSNAP_OWNER_EMAIL=you@example.com

# The interactive API docs page loads swagger-ui from a CDN — an unpinned
# script on the origin that holds the session cookie. Off unless opted in.
# BOOKSNAP_DOCS=1

# --- staff service (:8758) ---
# Unset, the staff service serves every tenant to anyone who can reach the
# port, and says so on screen (deliberate fail-open for local dev — owner,
# 2026-08-13). Set it anywhere the port is not loopback-private.
# BOOKSNAP_STAFF_TOKEN=

# --- provider sign-in (P4.2) ---
# Each provider appears on the login screen only if configured here.
# Google: one OAuth client (Web application) in Google Cloud Console, with
# the redirect URI https://<your domain>/api/v1/auth/oauth/google/callback
# BOOKSNAP_GOOGLE_CLIENT_ID=
# BOOKSNAP_GOOGLE_CLIENT_SECRET=
#
# Apple: needs a paid Apple Developer account, a Services ID, and a Sign in
# with Apple key (.p8). The private key is multi-line PEM — put it on ONE
# line with literal 
 between the lines. Redirect URI
# https://<your domain>/api/v1/auth/oauth/apple/callback (Apple requires
# HTTPS and refuses localhost, which is why this waits for a real domain).
# BOOKSNAP_APPLE_CLIENT_ID=com.example.booksnap
# BOOKSNAP_APPLE_TEAM_ID=
# BOOKSNAP_APPLE_KEY_ID=
# BOOKSNAP_APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----
MIG...
-----END PRIVATE KEY-----
