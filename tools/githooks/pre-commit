#!/bin/sh
# Commit gate. Two independent halves, both installed via:
#     git config core.hooksPath tools/githooks
#
#   1. ACCURACY  — the sweep + spotchecks. Guards the recognition core against
#      a silent regression.
#   2. PRODUCT   — the app/ rings from IMPLEMENTATION_PLAN H4: layering, the
#      API meta-tests, the OpenAPI->TypeScript contract, and the client
#      component tests.
#
# The halves are deliberately independent: product work must never require
# touching the accuracy baseline, and vice versa.
#
# This script only decides WHICH checks apply to the staged files.
# `tools/check.py` runs them — concurrently, against a core budget, reporting
# every failure rather than stopping at the first. Run it by hand any time:
#
#     python tools/check.py            # everything
#     python tools/check.py --product  # just the python rings + the contract
#
# Watchlist = everything the replay sweep actually exercises.

watch="booksnap/match.py booksnap/config.py booksnap/pipeline.py \
booksnap/catalog.py booksnap/scoring.py booksnap/replay.py booksnap/types.py \
booksnap/nli_catalog.py booksnap/simania_catalog.py booksnap/extra_catalogs.py \
ground_truth.json"

staged=$(git diff --cached --name-only)
hit=""
for f in $watch; do
    for s in $staged; do
        [ "$s" = "$f" ] && hit="$hit $f"
    done
done

# server.py owns the production retrieval chain (_build_catalog), which the
# offline replay sweep cannot exercise — remind, don't block.
for s in $staged; do
    if [ "$s" = "booksnap/server.py" ]; then
        echo "pre-commit note: server.py staged — if _build_catalog's retrieval"
        echo "chain changed, the replay gate can't see it; judge with:"
        echo "    python tools/sweep.py --live"
    fi
done

app_hit=""
web_hit=""
for s in $staged; do
    case "$s" in
        app/web/*)          web_hit=1; app_hit=1 ;;
        app/*|tests/*|tools/api_contract.py) app_hit=1 ;;
    esac
done

args=""
[ -n "$app_hit" ] && args="$args --product"
[ -n "$web_hit" ] && args="$args --web"
[ -n "$hit" ] && args="$args --accuracy"

if [ -z "$args" ]; then
    exit 0
fi

[ -n "$hit" ] && echo "pre-commit: accuracy-relevant files staged:$hit"
echo "pre-commit: running$args"
python tools/check.py $args
rc=$?
if [ $rc -ne 0 ]; then
    echo ""
    echo "COMMIT BLOCKED — see the failures above."
    echo ""
    echo "If an accuracy trade-off is intended and understood:"
    echo "    python tools/sweep.py --accept-baseline --note \"why\""
    echo "    git add tools/sweep_baseline.json"
    echo "A failing spotcheck means this change un-fixes owner feedback; the"
    echo "expectation that broke is in fixtures/spotchecks/<name>.json."
    exit $rc
fi
exit 0
