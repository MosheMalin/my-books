#!/bin/sh
# Commit gate. Two independent halves, both installed via:
#     git config core.hooksPath tools/githooks
#
#   1. ACCURACY  — the sweep + spotchecks, unchanged. Guards the recognition
#      core against a silent regression.
#   2. PRODUCT   — the app/ rings from IMPLEMENTATION_PLAN H4: layering, the
#      API meta-tests, the OpenAPI->TypeScript contract, and the client
#      component tests.
#
# The halves are deliberately independent: product work must never require
# touching the accuracy baseline, and vice versa.
#
# Watchlist = everything the replay sweep actually exercises. If any of these
# are staged, run `sweep.py --check` (offline, ~2s) against the committed
# baseline in tools/sweep_baseline.json.

watch="booksnap/match.py booksnap/config.py booksnap/pipeline.py \
booksnap/catalog.py booksnap/scoring.py booksnap/replay.py booksnap/types.py \
booksnap/nli_catalog.py booksnap/simania_catalog.py booksnap/extra_catalogs.py \
ground_truth.json"

staged=$(git diff --cached --name-only)
hit=""
for f in $watch; do
    for s in $staged; do
        [ "$s" = "$f" ] && hit="$hit $f"
    done
done

# server.py owns the production retrieval chain (_build_catalog), which the
# offline replay sweep cannot exercise — remind, don't block.
for s in $staged; do
    if [ "$s" = "booksnap/server.py" ]; then
        echo "pre-commit note: server.py staged — if _build_catalog's retrieval"
        echo "chain changed, the replay gate can't see it; judge with:"
        echo "    python tools/sweep.py --live"
    fi
done

# --- half 2: product rings -----------------------------------------------
# Runs before the accuracy gate because it is the faster of the two to fail
# and the one a product-only commit will actually trigger.
app_hit=""
web_hit=""
for s in $staged; do
    case "$s" in
        app/web/*)          web_hit=1; app_hit=1 ;;
        app/*|tests/*|tools/api_contract.py) app_hit=1 ;;
    esac
done

if [ -n "$app_hit" ]; then
    echo "pre-commit: product tests (layering + API rings)"
    python tests/run_all.py
    if [ $? -ne 0 ]; then
        echo ""
        echo "COMMIT BLOCKED: product tests failed (tests/run_all.py)."
        exit 1
    fi

    echo "pre-commit: API contract (DTOs -> OpenAPI -> TypeScript)"
    python tools/api_contract.py --check
    if [ $? -ne 0 ]; then
        echo ""
        echo "COMMIT BLOCKED: the committed API contract is stale."
        exit 1
    fi
fi

if [ -n "$web_hit" ]; then
    # Self-skips on a machine without the client toolchain installed, the same
    # way the spotchecks skip without run data — a gate that cannot run must
    # not be a gate that blocks.
    if [ -d app/web/node_modules ]; then
        echo "pre-commit: client tests (vitest)"
        npm --prefix app/web run test --silent
        if [ $? -ne 0 ]; then
            echo ""
            echo "COMMIT BLOCKED: client component tests failed."
            exit 1
        fi
        echo "pre-commit: client typecheck"
        npm --prefix app/web run typecheck --silent
        if [ $? -ne 0 ]; then
            echo ""
            echo "COMMIT BLOCKED: client does not typecheck."
            exit 1
        fi
    else
        echo "pre-commit: app/web staged but node_modules missing — client"
        echo "            checks skipped. Run: npm install --prefix app/web"
    fi
fi

# --- half 1: accuracy gate ------------------------------------------------
[ -z "$hit" ] && exit 0

echo "pre-commit: accuracy-relevant files staged:$hit"
echo "pre-commit: running regression gate (tools/sweep.py --check)"
python tools/sweep.py --check
rc=$?
if [ $rc -ne 0 ]; then
    echo ""
    echo "COMMIT BLOCKED: this change regresses the measured baseline."
    echo "Either fix it, or if the trade-off is intended and understood:"
    echo "    python tools/sweep.py --accept-baseline --note \"why\""
    echo "    git add tools/sweep_baseline.json"
    echo "and commit again."
    exit $rc
fi

# Owner-feedback spotchecks are part of the gate: the GT sweep never sees the
# shelves the owner reviewed by hand, and a rule change that un-fixes one of
# those complaints is a regression exactly like a sweep drop. Fixtures whose
# run data isn't on this machine skip themselves.
for fx in fixtures/spotchecks/*.json; do
    [ -e "$fx" ] || continue
    name=$(basename "$fx" .json)
    echo "pre-commit: spotcheck $name"
    python tools/spotcheck.py "$name"
    rc=$?
    if [ $rc -ne 0 ]; then
        echo ""
        echo "COMMIT BLOCKED: this change un-fixes owner feedback ($name)."
        echo "See fixtures/spotchecks/$name.json for the expectation that broke."
        exit $rc
    fi
done
exit 0
